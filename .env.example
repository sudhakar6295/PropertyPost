DJANGO_SETTINGS_MODULE=propertypost.settings.production
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=postgresql://user:password@host:5432/propertypost
DJANGO_ALLOWED_HOSTS=propertypost.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://propertypost.example.com
DJANGO_SECURE_SSL_REDIRECT=true
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_WEB_API_KEY=your-firebase-web-api-key
GOOGLE_CLOUD_PROJECT=your-google-cloud-project-id
FIRESTORE_DATABASE=(default)
GCS_PRIVATE_BUCKET=your-private-bucket-name
CAPTION_ADAPTER=local
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
AUTOMATION_HMAC_SECRET=replace-with-an-independent-random-32-byte-secret
