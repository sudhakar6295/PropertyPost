DJANGO_SETTINGS_MODULE=propertypost.settings.development
DJANGO_SECRET_KEY=replace-with-at-least-50-random-characters-before-use
MYSQL_DATABASE=propertypost
MYSQL_USER=propertypost
MYSQL_PASSWORD=replace-with-a-local-only-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-local-only-password
MYSQL_HOST=mysql
MYSQL_PORT=3306
# The local MySQL container does not require TLS; production enables it by default.
MYSQL_SSL_ENABLED=false
# Optional Hostinger CA certificate path for TLS (production only).
MYSQL_SSL_CA=
DJANGO_ALLOWED_HOSTS=propertypost.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://propertypost.example.com
DJANGO_SECURE_SSL_REDIRECT=true
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_WEB_API_KEY=your-firebase-web-api-key
GOOGLE_CLOUD_PROJECT=your-google-cloud-project-id
GCS_PRIVATE_BUCKET=your-private-bucket-name
CAPTION_ADAPTER=local
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
AUTOMATION_HMAC_SECRET=replace-with-an-independent-random-32-byte-secret
